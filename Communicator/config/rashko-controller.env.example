# Motor-control transport
RASHKO_BIND_HOST=0.0.0.0
RASHKO_PI_PORT=5005
RASHKO_SHARED_SECRET=
RASHKO_ALLOW_INSECURE=false

# Strongly recommended: comma-separated single IPv4 addresses or IPv4 CIDR
# subnets (e.g. 192.168.100.0/24,169.254.0.0/16). Leave empty to allow any LAN client.
RASHKO_ALLOWED_CLIENTS=

# Safety and protocol timing
RASHKO_WATCHDOG_MS=500
RASHKO_FRESHNESS_MS=5000
RASHKO_UPDATE_HZ=50
RASHKO_MAX_SESSIONS=128

# Keep dry-run until all commissioning checks in README.md pass.
RASHKO_HARDWARE_BACKEND=dry-run
RASHKO_SERVO_CONFIG=/etc/rashko-servos.json

# Camera Module 2 MJPEG service
RASHKO_CAMERA_BIND_HOST=0.0.0.0
RASHKO_CAMERA_PORT=8080
RASHKO_CAMERA_WIDTH=640
RASHKO_CAMERA_HEIGHT=480
RASHKO_CAMERA_FPS=15
RASHKO_CAMERA_JPEG_QUALITY=70
RASHKO_CAMERA_BACKEND=picamera2
