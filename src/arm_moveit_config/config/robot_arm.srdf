<?xml version="1.0" encoding="UTF-8"?>
<robot name="robot_urdf">
  <!-- LLM HANDOFF: These names must remain identical to robot_fixed.urdf. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool_tip"/>
  </group>
  <group name="gripper">
    <joint name="gripper_base"/>
  </group>
  <end_effector name="hand" parent_link="gripper_base" group="gripper" parent_group="arm"/>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

  <group_state name="home" group="arm">
    <joint name="base" value="0"/>
    <joint name="shoulder" value="0"/>
    <joint name="elbow" value="0"/>
    <joint name="wrist" value="0"/>
    <joint name="wrist_rotate" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_base" value="0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_base" value="1.2"/>
  </group_state>

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="tool_tip" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="servo_disc_3" reason="Adjacent"/>
</robot>
