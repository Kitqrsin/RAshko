# Set to "auto" to discover the Raspberry Pi automatically on your Ethernet
# connection, or set an explicit IPv4 address / hostname (e.g. 192.168.100.42).
RASHKO_PI_HOST=auto
RASHKO_PI_USER=tnt
# Optional mDNS/DNS hostname hint checked before scanning the Ethernet subnet:
RASHKO_PI_HOSTNAME=raspberrypi.local
# Physical Windows network adapter ("auto" selects active wired Ethernet first):
RASHKO_ETHERNET_ADAPTER=auto
# Automatically scan Ethernet and update RASHKO_PI_HOST when the Pi IP changes:
RASHKO_PI_AUTO_DISCOVER=true
RASHKO_ETHERNET_SUBNET=
RASHKO_PI_PORT=5005
RASHKO_SHARED_SECRET=replace-with-the-same-random-secret-used-on-the-pi
# Leave blank to use http://RASHKO_PI_HOST:RASHKO_CAMERA_PORT/stream.mjpg
RASHKO_CAMERA_PORT=8080
RASHKO_CAMERA_URL=
RASHKO_CAMERA_BACKEND=auto
# Exact-resolution ROS camera calibration YAML. Leave blank only for preview;
# cap inspection will remain locked without it.
RASHKO_CAMERA_INFO_FILE=
RASHKO_CAP_WORKCELL_CONFIG=/workspace/config/cap_workcell.example.yaml
RASHKO_CAP_CAMERA_WIDTH=640
RASHKO_CAP_CAMERA_HEIGHT=480
# Keep at 0 until the gripper horn/open pulse and safe close endpoint are calibrated.
RASHKO_GRIPPER_CLOSED_DEGREES=0
ROS_DOMAIN_ID=42
DISPLAY=host.docker.internal:0.0
